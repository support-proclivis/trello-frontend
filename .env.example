# Dev server port (must match FRONTEND_HOST_URL / CORS_ALLOWED_ORIGINS in the backend .env)
VITE_PORT=5173
# Backend address that /api requests are proxied to
VITE_API_PROXY_TARGET=http://localhost:3001
# Extra hostnames allowed to reach the dev server, comma-separated (e.g. .example.com)
VITE_ALLOWED_HOSTS=
